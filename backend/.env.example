# MongoDB Connection String
# استخدم رابط MongoDB Atlas الخاص بك
MONGO_URL=mongodb+srv://username:password@cluster0.mongodb.net/?appName=Cluster0

# Database Name
DB_NAME=taseer_db

# Secret Key for JWT Token (استخدم قيمة عشوائية قوية)
SECRET_KEY=your-secret-key-here-change-this-in-production

# Environment (development, staging, production)
ENVIRONMENT=production

# CORS Origins (للواجهة الأمامية)
CORS_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:3000

# Backend URL (للإشارة الذاتية)
BACKEND_URL=https://your-backend-domain.onrender.com
